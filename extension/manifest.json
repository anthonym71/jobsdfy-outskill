{
  "manifest_version": 3,
  "name": "JobsDFY",
  "version": "1.1.0",
  "description": "Send job listings to JobsDFY with one click",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://linkedin.com/jobs/*",
        "https://www.indeed.com/*",
        "https://indeed.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
